{
  "name": "codex-gauge",
  "version": "0.3.4",
  "description": "A desktop AI credit center with the original precision-styled Codex usage badge.",
  "main": "src/main.cjs",
  "author": "Aken",
  "license": "MIT",
  "repository": "https://github.com/Akenaiai/codex-gauge",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview": "node scripts/preview.cjs",
    "build:native": "node scripts/build-native.cjs",
    "postinstall": "node scripts/build-native.cjs",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "build:win": "npm run build:native && electron-builder --win nsis zip --x64",
    "build:mac": "npm run build:native && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aken.codexgauge",
    "productName": "Codex Gauge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "src/credit-date-observations.cjs",
        "to": "mcp/src/credit-date-observations.cjs"
      },
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "scripts/gauge-mcp.cjs",
        "to": "mcp/scripts/gauge-mcp.cjs"
      },
      {
        "from": "src/credit-model.cjs",
        "to": "mcp/src/credit-model.cjs"
      },
      {
        "from": "src/catalog.cjs",
        "to": "mcp/src/catalog.cjs"
      },
      {
        "from": "src/relay-credit-bridge.py",
        "to": "adapters/relay-credit-bridge.py"
      },
      {
        "from": "src/credit-policies.cjs",
        "to": "mcp/src/credit-policies.cjs"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "include": "native/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "native",
          "filter": [
            "GaugeHostMac.node",
            "libGaugeHostMac.dylib",
            "GaugeFollowMac"
          ]
        }
      ]
    },
    "publish": null
  }
}
